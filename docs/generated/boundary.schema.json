{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flight-recorder.dev/schemas/boundary-1.0.json",
  "title": "Replay Boundary",
  "type": "object",
  "required": ["id", "operation_span_id", "logical_key", "class", "side_effect", "replay_policy", "matching_rule", "occurrence"],
  "properties": {
    "id": {"type": "string"}, "operation_span_id": {"type": "string"}, "logical_key": {"type": "string", "minLength": 1},
    "class": {"type": "string"}, "parent_logical_key": {"type": "string"}, "request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "response": {"type": "object", "required": ["digest", "size"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "media_type": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "state": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": true}, "side_effect": {"enum": ["read_only", "mutating", "unknown"]},
    "replay_policy": {"enum": ["substitute", "live", "block"]}, "sandbox": {"type": "string"},
    "occurrence": {"type": "integer", "minimum": 0},
    "matching_rule": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["exact", "json_pointer"]}, "ignore_paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
