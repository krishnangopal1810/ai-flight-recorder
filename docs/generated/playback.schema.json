{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flight-recorder.dev/schemas/playback.schema.json",
  "title": "Playback Result",
  "type": "object",
  "required": ["schema_version", "mode", "executed", "application_processes_started", "outbound_requests", "manifest_verified", "capsule", "completeness", "payloads", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "playback"},
    "executed": {"const": false},
    "application_processes_started": {"const": 0},
    "outbound_requests": {"const": 0},
    "manifest_verified": {"const": true},
    "capsule": {"$ref": "run-capsule.schema.json"},
    "completeness": {"$ref": "capsule-completeness.schema.json"},
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "availability", "size", "references"],
        "properties": {
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "availability": {"enum": ["available", "missing", "corrupt", "unavailable"]},
          "media_type": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "original_size": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}},
          "preview": {"type": "string"},
          "preview_encoding": {"enum": ["json", "utf8", "base64"]},
          "preview_truncated": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "digest", "references", "message"],
        "properties": {
          "code": {"enum": ["payload_missing", "payload_corrupt", "payload_unavailable"]},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "references": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
