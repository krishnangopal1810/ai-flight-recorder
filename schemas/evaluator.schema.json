{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flight-recorder.dev/schemas/evaluator-1.0.json",
  "title": "Incident Evaluator",
  "type": "object",
  "required": ["schema_version", "id", "version", "image", "command", "timeout"],
  "properties": {
    "schema_version": {"const": "1.0"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}, "version": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "timeout": {"type": "integer", "description": "Go duration in nanoseconds"},
    "cpu_limit": {"type": "number", "minimum": 0}, "memory_limit_mb": {"type": "integer", "minimum": 0}, "model_hosts": {"type": "array", "items": {"type": "string"}}, "environment": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
